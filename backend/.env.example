TPLINK_EMAIL=
TPLINK_PASSWORD=
MQTT_BROKER_URL=mqtt://localhost:1883
ZIGBEE2MQTT_BASE_TOPIC=zigbee2mqtt
MQTT_USERNAME=
MQTT_PASSWORD=

# Nenko (dongle nRF52840 → 802.15.4 raw). Se NENKO_SERIAL_PATH è vuoto il service resta disattivo.
# La mappa dei tasti sta in src/devices/nenko/nenko-buttons.json (versionata).
NENKO_SERIAL_PATH=
NENKO_BAUD=115200
NENKO_TX_REPEAT=6